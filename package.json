{
  "name": "satex-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/db/types.ts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:reference": "tsx scripts/seed.ts --reference-only",
    "textures:preview": "tsx scripts/generate-textures.ts",
    "e2e:auth": "playwright test --config playwright.auth.config.ts",
    "env:local": "node scripts/supabase-env.mjs > .env.local"
  },
  "dependencies": {
    "@react-email/render": "^2.2.0",
    "@react-pdf/renderer": "4.9.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@sentry/nextjs": "11.11.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "next": "15.5.29",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "intl-messageformat": "12.1.4",
    "pg": "8.23.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.32"
    }
  }
}
