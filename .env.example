# Names only. Real values live in the team password manager / Vercel / Supabase. Never commit .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (filled from `supabase start` locally) - used from P1-03
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI (P1-09)
AI_PROVIDER=anthropic
EMBED_PROVIDER=voyage
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-multimodal-3
EMBEDDING_DIM=1024
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
# AI_PROVIDER=fake and EMBED_PROVIDER=fake give deterministic results without any key (tests, offline work)
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
EMBED_PRICE_PER_MTOK=

# Email, jobs, monitoring (P1-08, P1-17)
RESEND_API_KEY=
EMAIL_FROM=
# log = nothing is sent, the rendered email is kept in email_log (local development); resend = real delivery
EMAIL_PROVIDER=log
# the job runner (/api/jobs/run) refuses every call that does not carry this secret
CRON_SECRET=
# seconds before attempt 2 and 3 of a failed job (default 30,300,1800)
JOB_RETRY_DELAYS_S=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
IP_HASH_SALT=

# Phase 4
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
